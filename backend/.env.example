NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# PostgreSQL connection string.
# Local dev uses the docker-compose mapping on port 5434:
#   postgresql://postgres:postgres_password_123@localhost:5434/shopv1?schema=public
# In production use the database's INTERNAL hostname, never localhost.
DATABASE_URL=

# Public origin this API is reachable at. Used to build product image URLs,
# so it must be the real domain in production (e.g. https://api.vongshop.com)
# or every image 404s for visitors.
PUBLIC_APP_URL=http://localhost:5000

# Legacy MongoDB connection — only needed to run migrateMongoToPostgres.ts
MONGO_URI=

# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Stripe Dashboard > Developers > API keys / Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase Dashboard > Settings > API / Storage
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=

# Used by seedAdmin.ts to create the initial admin user
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Unsplash Developer dashboard (used by product seeders)
UNSPLASH_ACCESS_KEY=
