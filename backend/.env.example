NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB connection string (Atlas or local)
MONGO_URI=

# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Stripe Dashboard > Developers > API keys / Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase Dashboard > Settings > API / Storage
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=

# Used by seedAdmin.ts to create the initial admin user
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Unsplash Developer dashboard (used by product seeders)
UNSPLASH_ACCESS_KEY=
